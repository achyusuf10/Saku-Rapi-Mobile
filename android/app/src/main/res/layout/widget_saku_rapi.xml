<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <!-- Top Row: Arrow Nav + Wallet Display + Eye Toggle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Arrow Left -->
        <ImageButton
            android:id="@+id/btn_prev"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_arrow_left"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:contentDescription="Previous wallet" />

        <!-- Wallet Info (Center) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/tv_wallet_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_empty_wallets"
                android:textSize="12sp"
                android:textColor="@color/widget_text_secondary"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_wallet_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_balance_hidden"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_primary"
                android:maxLines="1"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tv_wallet_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="10sp"
                android:textColor="@color/widget_text_tertiary"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- Eye Toggle -->
        <ImageButton
            android:id="@+id/btn_toggle_balance"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_eye_off"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:contentDescription="Toggle balance visibility" />

        <!-- Arrow Right -->
        <ImageButton
            android:id="@+id/btn_next"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_arrow_right"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:contentDescription="Next wallet" />

    </LinearLayout>

    <!-- Divider -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@color/widget_border"
        android:contentDescription="" />

    <!-- Bottom: 4 Quick Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Manual -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btn_manual"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_widget_manual"
                android:background="@drawable/widget_action_bg"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:contentDescription="@string/widget_action_manual" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_action_manual"
                android:textSize="10sp"
                android:textColor="@color/widget_text_secondary"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- Voice -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btn_voice"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_widget_voice"
                android:background="@drawable/widget_action_bg"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:contentDescription="@string/widget_action_voice" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_action_voice"
                android:textSize="10sp"
                android:textColor="@color/widget_text_secondary"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- Camera / OCR -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btn_camera"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_widget_camera"
                android:background="@drawable/widget_action_bg"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:contentDescription="@string/widget_action_camera" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_action_camera"
                android:textSize="10sp"
                android:textColor="@color/widget_text_secondary"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- Text -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btn_text"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_widget_text"
                android:background="@drawable/widget_action_bg"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:contentDescription="@string/widget_action_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_action_text"
                android:textSize="10sp"
                android:textColor="@color/widget_text_secondary"
                android:layout_marginTop="2dp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
